{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RASOrbit Input Editor",
  "identifier": "com.jcsw.roinput",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RASOrbit Input Editor",
        "width": 1000,
        "height": 700,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["dat"],
        "name": "RASOrbit Input File",
        "description": "RASOrbit input file",
        "mimeType": "text/plain",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.jcsw.roinput.dat",
          "conformsTo": ["public.plain-text", "public.data"]
        }
      }
    ],
    "targets": "all",
    "publisher": "John Coker <john@jcsw.com>",
    "copyright": "Copyright © 2026 John Coker",
    "homepage": "https://johncoker.github.io/roinput/",
    "license": "ISC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "signCommand": {
        "cmd": "trusted-signing-cli",
        "args": [
          "-e", "https://wus.codesigning.azure.net",
          "-a", "JCSW",
          "-c", "AppSigning",
          "%1"
        ]
      }
    }
  }
}
